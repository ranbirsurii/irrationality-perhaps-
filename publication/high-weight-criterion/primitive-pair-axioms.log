  (hk : 0 < k) (hP : 0 ≤ P) (ha : |La| ≤ P * √A / h) (hb : |Lb| ≤ P * √C / k) :
  |La| ≤ P * √(OddZeta.primitivePairSpectralCost A B C h k) ∧ |Lb| ≤ P * √(OddZeta.primitivePairSpectralCost A B C h k)
OddZeta.integral_normalized_form (a c h : ℤ) (α : ℝ) (ha : h ∣ a) (hc : h ∣ c) (hh : ↑h ≠ 0) :
  ↑(a / h) * α + ↑(c / h) = (↑a * α + ↑c) / ↑h
OddZeta.integral_normalized_pair_nonvanishing (a b c d h k : ℤ) (α : ℝ) (ha : h ∣ a) (hc : h ∣ c) (hb : k ∣ b)
  (hd : k ∣ d) (hh : ↑h ≠ 0) (hk : ↑k ≠ 0) (hdet : a * d - b * c ≠ 0) :

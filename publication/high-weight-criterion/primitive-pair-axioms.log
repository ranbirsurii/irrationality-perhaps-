OddZeta.signed_prefix_recenter_error (alpha p q F e : ℝ) (hp : p ≠ 0) (h : |p * alpha + q - F| ≤ e) :
  |alpha - (F - q) / p| ≤ e / |p|
OddZeta.signed_prefix_recenter_radius (p q F e : ℝ) : |(F - q) / p - -q / p| + e / |p| = (|F| + e) / |p|
OddZeta.nested_interval_form_majorant (oldCenter newCenter oldRadius newRadius p q : ℝ)
  (href : |newCenter - oldCenter| + newRadius ≤ oldRadius) :
  |p * newCenter + q| + |p| * newRadius ≤ |p * oldCenter + q| + |p| * oldRadius

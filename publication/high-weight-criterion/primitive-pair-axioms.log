OddZeta.slope_error_transfer (alpha sigma p q delta : ℝ) (h : |alpha - sigma| ≤ delta) :
  |p * alpha + q| ≤ |p * sigma + q| + |p| * delta
OddZeta.nonzero_small_form_of_independent_slope_pair (alpha sigma delta E : ℝ) (p0 q0 p1 q1 : ℤ)
  (happrox : |alpha - sigma| ≤ delta) (hdet : p0 * q1 - p1 * q0 ≠ 0) (h0 : |↑p0 * sigma + ↑q0| + |↑p0| * delta ≤ E)
  (h1 : |↑p1 * sigma + ↑q1| + |↑p1| * delta ≤ E) : ∃ p q, 0 < |↑p * alpha + ↑q| ∧ |↑p * alpha + ↑q| ≤ E

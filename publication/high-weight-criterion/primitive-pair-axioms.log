OddZeta.psd_gram_eigenmax_bounds (A B C : ℝ) (hA : 0 ≤ A) (hC : 0 ≤ C) (hBC : B ^ 2 ≤ A * C) :
  A ≤ OddZeta.gramEigenMax A B C ∧ C ≤ OddZeta.gramEigenMax A B C ∧ OddZeta.gramEigenMax A B C ≤ A + C
OddZeta.individually_scaled_gram_psd (A B C h k : ℝ) (hBC : B ^ 2 ≤ A * C) (hh : 0 < h) (hk : 0 < k) :
  (B / (h * k)) ^ 2 ≤ A / h ^ 2 * (C / k ^ 2)
OddZeta.primitive_pair_spectral_bounds (A B C h k : ℝ) (hA : 0 ≤ A) (hC : 0 ≤ C) (hBC : B ^ 2 ≤ A * C) (hh : 0 < h)
  (hk : 0 < k) :
  A / h ^ 2 ≤ OddZeta.primitivePairSpectralCost A B C h k ∧
    C / k ^ 2 ≤ OddZeta.primitivePairSpectralCost A B C h k ∧
      OddZeta.primitivePairSpectralCost A B C h k ≤ A / h ^ 2 + C / k ^ 2
OddZeta.primitive_pair_trace_le_common_content (A C h k Γ : ℝ) (hA : 0 ≤ A) (hC : 0 ≤ C) (hΓ : 0 < Γ) (hh : Γ ≤ h)
  (hk : Γ ≤ k) : A / h ^ 2 + C / k ^ 2 ≤ (A + C) / Γ ^ 2

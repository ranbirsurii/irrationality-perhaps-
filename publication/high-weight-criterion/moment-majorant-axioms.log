OddZeta.signed_prefix_cauchy (P T a b E : ℝ) (hP : 0 < P) (hT : 0 < T) (hb : b ^ 2 ≤ T * E) :
  (a + b) ^ 2 ≤ (P + T) * (a ^ 2 / P + E)

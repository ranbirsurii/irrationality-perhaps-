OddZeta.integer_square_ge_abs (z : ℤ) : |↑z| ≤ ↑z ^ 2
OddZeta.reduced_binary_cross_bound (A B x y : ℝ) (hB : 2 * |B| ≤ A) : -(A * |x| * |y|) ≤ 2 * B * x * y
OddZeta.reduced_binary_half_diagonal (A B C x y : ℝ) (hA : 0 ≤ A) (hAC : A ≤ C) (hB : 2 * |B| ≤ A) :
  (A * x ^ 2 + C * y ^ 2) / 2 ≤ OddZeta.binaryQuadratic A B C x y
OddZeta.reduced_binary_second_coordinate_minimum (A B C : ℝ) (hA : 0 < A) (hAC : A ≤ C) (hB : 2 * |B| ≤ A) (u v : ℤ)
  (hv : v ≠ 0) : C ≤ OddZeta.binaryQuadratic A B C ↑u ↑v
OddZeta.reduced_binary_first_minimum (A B C : ℝ) (hA : 0 < A) (hAC : A ≤ C) (hB : 2 * |B| ≤ A) (u v : ℤ)
  (hnonzero : u ≠ 0 ∨ v ≠ 0) : A ≤ OddZeta.binaryQuadratic A B C ↑u ↑v
OddZeta.reduced_binary_independent_pair_minimum (A B C : ℝ) (hA : 0 < A) (hAC : A ≤ C) (hB : 2 * |B| ≤ A) (u v w z : ℤ)
  (hdet : u * z - v * w ≠ 0) : C ≤ max (OddZeta.binaryQuadratic A B C ↑u ↑v) (OddZeta.binaryQuadratic A B C ↑w ↑z)
OddZeta.reduced_binary_coordinate_attainment (A B C : ℝ) :
  OddZeta.binaryQuadratic A B C 1 0 = A ∧ OddZeta.binaryQuadratic A B C 0 1 = C
OddZeta.reduced_binary_transference_squared (A B C : ℝ) (hA : 0 < A) (hAC : A ≤ C) (hB : 2 * |B| ≤ A) :
  0 < A * C - B ^ 2 ∧ 1 ≤ A * C / (A * C - B ^ 2) ∧ A * C / (A * C - B ^ 2) ≤ 4 / 3
OddZeta.reduced_binary_cost_sandwich (mu beta nu H2 delta : ℝ) (hmu : 0 < mu) (horder : mu ≤ nu)
  (hbeta : 2 * |beta| ≤ mu) (hdelta : delta ≠ 0) (hidentity : mu * nu - beta ^ 2 = delta ^ 2 * H2) :
  H2 / mu ≤ nu / delta ^ 2 ∧ nu / delta ^ 2 ≤ 4 * H2 / (3 * mu)
OddZeta.dual_gram_determinant_identity (A B C ya yb za zb : ℝ) :
  OddZeta.dualGramFirst A B C ya yb * OddZeta.dualGramSecond A B C za zb - OddZeta.dualGramCross A B C ya yb za zb ^ 2 =
    (ya * zb - yb * za) ^ 2 * (A * C - B ^ 2)
OddZeta.dual_gram_pullback_identity (A B C ya yb za zb p q : ℝ) :
  OddZeta.binaryQuadratic (OddZeta.dualGramFirst A B C ya yb) (OddZeta.dualGramCross A B C ya yb za zb)
      (OddZeta.dualGramSecond A B C za zb) p q =
    OddZeta.binaryQuadratic C (-B) A (p * ya + q * za) (p * yb + q * zb)
OddZeta.dual_gram_primal_adjugate_identity (A B C ya yb za zb : ℝ) :
  OddZeta.binaryQuadratic A B C zb (-za) = OddZeta.dualGramSecond A B C za zb ∧
    A * zb * -yb + B * (zb * ya + -za * -yb) + C * -za * ya = -OddZeta.dualGramCross A B C ya yb za zb ∧
      OddZeta.binaryQuadratic A B C (-yb) ya = OddZeta.dualGramFirst A B C ya yb
OddZeta.binary_adjugate_quarter_turn (A B C x y : ℝ) :
  OddZeta.binaryQuadratic C (-B) A x y = OddZeta.binaryQuadratic A B C (-y) x
OddZeta.binary_quadratic_positive (A B C x y : ℝ) (hA : 0 < A) (hdet : 0 < A * C - B ^ 2) (hnonzero : x ≠ 0 ∨ y ≠ 0) :
  0 < OddZeta.binaryQuadratic A B C x y
OddZeta.coefficient_row_pair_nonzero (ya yb za zb p q : ℝ) (hdet : ya * zb - yb * za ≠ 0) (hnonzero : p ≠ 0 ∨ q ≠ 0) :
  p * ya + q * za ≠ 0 ∨ p * yb + q * zb ≠ 0
OddZeta.dual_gram_quadratic_positive (A B C ya yb za zb p q : ℝ) (hC : 0 < C) (hgram : 0 < A * C - B ^ 2)
  (hdet : ya * zb - yb * za ≠ 0) (hnonzero : p ≠ 0 ∨ q ≠ 0) :
  0 <
    OddZeta.binaryQuadratic (OddZeta.dualGramFirst A B C ya yb) (OddZeta.dualGramCross A B C ya yb za zb)
      (OddZeta.dualGramSecond A B C za zb) p q
OddZeta.unimodular_integer_preimage (a b c d : ℤ) (hdet : a * d - b * c = 1 ∨ a * d - b * c = -1) (x y : ℤ) :
  ∃ u v, a * u + b * v = x ∧ c * u + d * v = y
OddZeta.binary_change_of_variables (A B C a b c d x y : ℝ) :
  OddZeta.binaryQuadratic A B C (a * x + b * y) (c * x + d * y) =
    OddZeta.binaryQuadratic (OddZeta.binaryQuadratic A B C a c) (A * a * b + B * (a * d + b * c) + C * c * d)
      (OddZeta.binaryQuadratic A B C b d) x y
OddZeta.binary_certificate_first_minimum (A B C mu beta nu : ℝ) (a b c d : ℤ)
  (hdet : a * d - b * c = 1 ∨ a * d - b * c = -1) (hfirst : mu = OddZeta.binaryQuadratic A B C ↑a ↑c)
  (hcross : beta = A * ↑a * ↑b + B * (↑a * ↑d + ↑b * ↑c) + C * ↑c * ↑d)
  (hsecond : nu = OddZeta.binaryQuadratic A B C ↑b ↑d) (hmu : 0 < mu) (horder : mu ≤ nu) (hbeta : 2 * |beta| ≤ mu)
  (x y : ℤ) (hne : x ≠ 0 ∨ y ≠ 0) : mu ≤ OddZeta.binaryQuadratic A B C ↑x ↑y
OddZeta.binary_certificate_independent_pair_minimum (A B C mu beta nu : ℝ) (a b c d : ℤ)
  (hdet : a * d - b * c = 1 ∨ a * d - b * c = -1) (hfirst : mu = OddZeta.binaryQuadratic A B C ↑a ↑c)
  (hcross : beta = A * ↑a * ↑b + B * (↑a * ↑d + ↑b * ↑c) + C * ↑c * ↑d)
  (hsecond : nu = OddZeta.binaryQuadratic A B C ↑b ↑d) (hmu : 0 < mu) (horder : mu ≤ nu) (hbeta : 2 * |beta| ≤ mu)
  (p q r s : ℤ) (hpairs : p * s - q * r ≠ 0) :
  nu ≤ max (OddZeta.binaryQuadratic A B C ↑p ↑q) (OddZeta.binaryQuadratic A B C ↑r ↑s)
OddZeta.binary_certificate_attainment (A B C mu nu : ℝ) (a b c d : ℤ) (hdet : a * d - b * c = 1 ∨ a * d - b * c = -1)
  (hfirst : mu = OddZeta.binaryQuadratic A B C ↑a ↑c) (hsecond : nu = OddZeta.binaryQuadratic A B C ↑b ↑d) :
  ∃ x y z t, x * t - y * z ≠ 0 ∧ OddZeta.binaryQuadratic A B C ↑x ↑y = mu ∧ OddZeta.binaryQuadratic A B C ↑z ↑t = nu

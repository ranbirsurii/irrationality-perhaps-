OddZeta.finite_field_sum_eval_zero.{u_1} {K : Type u_1} [Field K] [Fintype K] (P : Polynomial K)
  (hdegree : P.natDegree < Fintype.card K - 1) : ∑ a, Polynomial.eval a P = 0
OddZeta.translation_trace_coefficient.{u_1} {K : Type u_1} [Field K] [Fintype K] (P : Polynomial K) (k : ℕ) :
  (OddZeta.polynomialTranslationTrace P).coeff k = ∑ a, Polynomial.eval a ((Polynomial.hasseDeriv k) P)
OddZeta.translation_trace_coefficient_vanishes.{u_1} {K : Type u_1} [Field K] [Fintype K] (P : Polynomial K) (k : ℕ)
  (hdegree : P.natDegree < k + (Fintype.card K - 1)) : (OddZeta.polynomialTranslationTrace P).coeff k = 0
OddZeta.translation_trace_small_polynomial_zero.{u_1} {K : Type u_1} [Field K] [Fintype K] (P : Polynomial K)
  (hdegree : P.natDegree < Fintype.card K - 1) : OddZeta.polynomialTranslationTrace P = 0
OddZeta.translation_trace_composition_coefficient_vanishes.{u_1} {K : Type u_1} [Field K] [Fintype K]
  (P R F : Polynomial K) (k : ℕ) (hk : 0 < k) (hF : 0 < F.natDegree)
  (hidentify : OddZeta.polynomialTranslationTrace P = R.comp F)
  (hdegree : P.natDegree < k * F.natDegree + (Fintype.card K - 1)) : R.coeff k = 0

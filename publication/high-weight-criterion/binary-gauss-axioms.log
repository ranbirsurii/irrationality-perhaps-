OddZeta.integer_det_row_envelope.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (A : Matrix n n ℤ) (H : n → ℤ)
  (hA : ∀ (i j : n), |A i j| ≤ H i) : |A.det| ≤ ↑(Fintype.card n).factorial * ∏ i, H i
OddZeta.integer_cramer_row_envelope.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (A : Matrix n n ℤ) (b H : n → ℤ)
  (hA : ∀ (i j : n), |A i j| ≤ H i) (hb : ∀ (i : n), |b i| ≤ H i) (j : n) :
  |A.cramer b j| ≤ ↑(Fintype.card n).factorial * ∏ i, H i
OddZeta.integer_cramer_cancellation.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (A : Matrix n n ℤ) (b : n → ℤ)
  (i : n) : ∑ j, A i j * -A.cramer b j + b i * A.det = 0
OddZeta.integer_cramer_mass_envelope.{u_1} {n : Type u_1} [Fintype n] [DecidableEq n] (A : Matrix n n ℤ) (b H : n → ℤ)
  (hA : ∀ (i j : n), |A i j| ≤ H i) (hb : ∀ (i : n), |b i| ≤ H i) :
  ∑ j, |(-A.cramer b j)| + |A.det| ≤ (↑(Fintype.card n) + 1) * (↑(Fintype.card n).factorial * ∏ i, H i)
OddZeta.integer_two_free_coordinates_independent (delta u v : ℤ) (hdelta : delta ≠ 0) (hu : u * delta = 0)
  (hv : v * delta = 0) : u = 0 ∧ v = 0

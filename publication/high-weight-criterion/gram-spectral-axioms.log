OddZeta.reduced_gram_eigenvalue_bounds (A B C : ℝ) (hA : 0 ≤ A) (hAC : A ≤ C) (hB : 2 * |B| ≤ A) :
  A / 2 ≤ OddZeta.gramEigenMin A B C ∧
    OddZeta.gramEigenMin A B C ≤ A ∧ C ≤ OddZeta.gramEigenMax A B C ∧ OddZeta.gramEigenMax A B C ≤ 3 * C / 2
OddZeta.gram_cost_bound_from_eigenvalue (A B C P Γ K : ℝ) (hA : 0 ≤ A) (hAC : A ≤ C) (hB : 2 * |B| ≤ A) (hP : 0 ≤ P)
  (hΓ : 0 < Γ) (hK : K ≤ P * √C / Γ) : K ≤ P * √(OddZeta.gramEigenMax A B C) / Γ

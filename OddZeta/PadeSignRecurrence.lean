import OddZeta.PadeCoefficientSign

namespace OddZeta

def evalNatPoly : List ℕ → ℚ → ℚ
  | [], _ => 0
  | a :: tail, x => a + x * evalNatPoly tail x

theorem evalNatPoly_nonneg (cs : List ℕ) (x : ℚ) (hx : 0 ≤ x) :
    0 ≤ evalNatPoly cs x := by
  induction cs with
  | nil => simp [evalNatPoly]
  | cons a tail ih =>
    simp only [evalNatPoly]
    exact add_nonneg (Nat.cast_nonneg _) (mul_nonneg hx ih)

theorem evalNatPoly_cons_pos (a : ℕ) (tail : List ℕ) (x : ℚ)
    (ha : 0 < a) (hx : 0 ≤ x) : 0 < evalNatPoly (a :: tail) x := by
  simp only [evalNatPoly]
  exact add_pos_of_pos_of_nonneg (by exact_mod_cast ha)
    (mul_nonneg hx (evalNatPoly_nonneg tail x hx))

theorem thirdOrderRatioCone_step (A B C D x y z w : ℚ)
    (hA : 0 ≤ A) (hB : 0 ≤ B) (hD : 0 < D) (hx : 0 < x)
    (hxy : 1000 * x ≤ y) (hyz : 1000 * y ≤ z)
    (hc : 1000000000 * D + 1000 * B + A ≤ 1000000 * C)
    (hr : D * w = C * z - B * y - A * x) : 1000 * z ≤ w := by
  have hz : 0 < z := by linarith
  have hxz : 1000000 * x ≤ z := by linarith
  have ha := mul_le_mul_of_nonneg_left hxz hA
  have hb := mul_le_mul_of_nonneg_left hyz hB
  have hh := mul_le_mul_of_nonneg_right hc hz.le
  apply (mul_le_mul_iff_right₀ hD).mp
  nlinarith

def thirdOrderState (A B C D : ℕ → ℚ) (u v w : ℚ) : ℕ → ℚ × ℚ × ℚ
  | 0 => (u, v, w)
  | n + 1 =>
    let st := thirdOrderState A B C D u v w n
    (st.2.1, st.2.2, (C n * st.2.2 - B n * st.2.1 - A n * st.1) / D n)

theorem thirdOrderState_cone (A B C D : ℕ → ℚ) (u v w : ℚ)
    (hcoef : ∀ n, 0 ≤ A n ∧ 0 ≤ B n ∧ 0 < D n ∧
      1000000000 * D n + 1000 * B n + A n ≤ 1000000 * C n)
    (hu : 0 < u) (huv : 1000 * u ≤ v) (hvw : 1000 * v ≤ w) :
    ∀ n, let st := thirdOrderState A B C D u v w n
      0 < st.1 ∧ 1000 * st.1 ≤ st.2.1 ∧ 1000 * st.2.1 ≤ st.2.2 := by
  intro n
  induction n with
  | zero => exact ⟨hu, huv, hvw⟩
  | succ n ih =>
    change 0 < (thirdOrderState A B C D u v w n).2.1 ∧
      1000 * (thirdOrderState A B C D u v w n).2.1 ≤
        (thirdOrderState A B C D u v w n).2.2 ∧
      1000 * (thirdOrderState A B C D u v w n).2.2 ≤
        (C n * (thirdOrderState A B C D u v w n).2.2 -
          B n * (thirdOrderState A B C D u v w n).2.1 -
          A n * (thirdOrderState A B C D u v w n).1) / D n
    obtain ⟨ha, hb, hd, hc⟩ := hcoef n
    have hrec : D n * ((C n * (thirdOrderState A B C D u v w n).2.2 -
        B n * (thirdOrderState A B C D u v w n).2.1 -
        A n * (thirdOrderState A B C D u v w n).1) / D n) =
        C n * (thirdOrderState A B C D u v w n).2.2 -
        B n * (thirdOrderState A B C D u v w n).2.1 -
        A n * (thirdOrderState A B C D u v w n).1 := by field_simp
    refine ⟨?_, ih.2.2, thirdOrderRatioCone_step _ _ _ _ _ _ _ _
      ha hb hd ih.1 ih.2.1 ih.2.2 hc hrec⟩
    linarith [ih.1, ih.2.1]


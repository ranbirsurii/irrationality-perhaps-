theorem padeSignCoefficients0 (k : ℕ) :
    0 ≤ padeSignA0 k ∧ 0 ≤ padeSignB0 k ∧ 0 < padeSignD0 k ∧
      1000000000 * padeSignD0 k + 1000 * padeSignB0 k + padeSignA0 k ≤
        1000000 * padeSignC0 k := by
  have ha : 0 ≤ padeSignA0 k := evalNatPoly_nonneg _ _ (by positivity)
  have hb : 0 ≤ padeSignB0 k := evalNatPoly_nonneg _ _ (by positivity)
  have hd : 0 < padeSignD0 k := by
    unfold padeSignD0
    exact evalNatPoly_cons_pos _ _ _ (by norm_num) (by positivity)
  have hm : 0 ≤ padeSignMargin0 k := evalNatPoly_nonneg _ _ (by positivity)
  have hid : 1000000 * padeSignC0 k - 1000000000 * padeSignD0 k -
      1000 * padeSignB0 k - padeSignA0 k = padeSignMargin0 k := by
    norm_num [padeSignA0, padeSignB0, padeSignC0, padeSignD0,
      padeSignMargin0, evalNatPoly]
    ring
  exact ⟨ha, hb, hd, by linarith⟩

